# Copia este archivo como .env y rellena lo que tengas. Nunca compartas el .env.
PORT=8080
HOST=127.0.0.1
DB_PATH=/var/lib/jarvis/jarvis.db
BACKUP_DIR=/var/lib/jarvis/backups

# ChatGPT por API (principal). Se paga aparte de la suscripción de ChatGPT.
OPENAI_API_KEY=
# Déjalo vacío: JARVIS elige el modelo más barato que tu cuenta tenga
OPENAI_MODEL=

# Claude por API (opcional: activa el debate entre dos IA)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Modelo gratis en el mismo servidor (Ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Topes de gasto de IA (US$). JARVIS no pasa de aquí.
AI_MONTHLY_CAP_USD=10
AI_DAILY_CAP_USD=0.5

# Alpaca (cuenta gratuita de práctica, solo datos). Sin esto se usa Yahoo como respaldo no oficial.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# La SEC pide identificarse con nombre y correo
SEC_USER_AGENT=JARVIS investigacion personal tu-correo@ejemplo.com

# Cuenta virtual personal
START_CASH_USD=100
TRADE_MIN_USD=5
TRADE_MAX_USD=10
DAILY_SUMMARY_HOUR_RD=8

# Avisos al celular: instala la app ntfy y suscríbete a este tema secreto
NTFY_TOPIC=
# Copia cifrada fuera del servidor (rclone configurado con Google Drive) y tu frase secreta
RCLONE_REMOTE=
BACKUP_PASSPHRASE=
